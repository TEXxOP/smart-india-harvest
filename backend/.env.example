# Copy to backend/.env for local development. Never commit the filled-in file.
# On Render these are set under the service's Environment tab instead
# (DATABASE_URL and GROQ_API_KEY are declared `sync: false` in render.yaml, so
# Render prompts for them when the Blueprint is first created).

# Postgres connection string. Neon, Supabase, or Render Postgres all work.
# A `postgres://` prefix is rewritten to `postgresql://` automatically.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Groq API key — powers the AI chat, voice transcription, crop reasoning,
# irrigation advice, and action-plan endpoints.
GROQ_API_KEY=gsk_your_key_here

# Optional: log every SQL statement and its row values. Leave false outside
# of local debugging.
SQL_ECHO=false

# Optional, dev only: which HuggingFace model export_disease_onnx.py pulls.
# The server does not read the Hub at all — it loads disease_model/model.onnx
# from disk — so changing this has no effect until you re-run the export.
# DISEASE_MODEL_ID=wambugu71/crop_leaf_diseases_vit
